# Temporal Environment Configuration
# This file contains the environment variables used by Temporal services
# Copy this file to .env.local - secrets will be auto-generated

# =============================================================================
# Temporal Versions
# =============================================================================
# Specify the Temporal Docker image versions to use
# Version 1.28.0 is stable and tested with auto-setup migration
# Can upgrade to 1.29.0 later after stabilization
TEMPORAL_VERSION=1.28.0
TEMPORAL_UI_VERSION=2.36.0
# Admin tools use major.minor versioning (no patch number)
TEMPORAL_ADMIN_VERSION=1.28

# =============================================================================
# Temporal Namespace
# =============================================================================
# Namespace for workflow execution (auto-created on startup)
TEMPORAL_NAMESPACE=xiansai
TEMPORAL_NAMESPACE_RETENTION_DAYS=7

# =============================================================================
# Host IP
# =============================================================================
AUTH_HOST=
TEMPORAL_HOST=

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=

# =============================================================================
# Temporal UI Authentication
# =============================================================================
# Client secret for Temporal UI authentication with Keycloak
TEMPORAL_UI_CLIENT_SECRET=

# =============================================================================
# mTLS Configuration (Default - for secure service communication)
# =============================================================================
# Certificates are auto-generated by create-secrets.sh in temporal/certs/
# The temporal/certs/ directory is mounted to /etc/temporal/certs/ in containers
# Certificate file paths (inside container, referenced by docker-compose.yml)

# Server certificate for Temporal (with SAN: temporal, localhost)
TEMPORAL_SERVER_CERT=/etc/temporal/certs/temporal.crt
TEMPORAL_SERVER_KEY=/etc/temporal/certs/temporal.key

# CA certificate for verifying client certificates
TEMPORAL_CA_CERT=/etc/temporal/certs/ca.crt

# Client certificate for Temporal UI
TEMPORAL_UI_CERT=/etc/temporal/certs/temporal-ui.crt
TEMPORAL_UI_KEY=/etc/temporal/certs/temporal-ui.key
